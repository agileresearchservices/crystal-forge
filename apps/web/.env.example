# OpenSearch Connection Configuration
# Copy this file to .env.local and fill in your actual values

# OpenSearch cluster URL
# - Local development: http://localhost:9200
# - Docker Compose: Set to http://opensearch:9200 in docker-compose.yml
# - Remote cluster: https://your-cluster.example.com:9200
OPENSEARCH_HOST=https://localhost:9200

# OpenSearch authentication
# Only required if your cluster has security enabled
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=your-password-here

# Docker environment variable
# Used internally to translate localhost to opensearch service name
# Set automatically by docker-compose.yml
# OPENSEARCH_DOCKER_HOST=opensearch
