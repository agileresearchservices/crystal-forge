# Dependencies
node_modules
**/node_modules

# Build outputs (we build inside Docker)
.next
**/.next
**/dist
**/.turbo

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# Environment files (should not be in image)
.env
.env.*
!.env.example
!.env.docker

# Documentation (keep README for reference)
*.md
!README.md

# Test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/coverage
**/__tests__

# OS files
.DS_Store
Thumbs.db

# Docker files (not needed inside image)
Dockerfile*
docker-compose*.yml
.dockerignore

# Claude Code
.claude/

# Logs
*.log
npm-debug.log*
